# Set to 1 only for local development or an access-protected preview.
COPTLE_DEV_FIXTURES=0

# Optional server-only URL for the dedicated development PostgreSQL LOGIN role.
# Never point this at a production content database.
COPTLE_FIXTURE_DATABASE_URL=
# Optional local SQLite path. Defaults to .coptle/fixtures.sqlite.
COPTLE_FIXTURE_DB_FILE=

# Optional staff-only Content Studio. Set all three together.
COPTLE_SUPABASE_URL=
COPTLE_SUPABASE_PUBLISHABLE_KEY=
COPTLE_STUDIO_DATABASE_URL=

# Reviewed play remains off until the launch inventory and development deployment are verified.
COPTLE_REVIEWED_PLAY=0
COPTLE_PLAY_DATABASE_URL=
